SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Android OAuth 2.0 client id for the "back up to Google Drive" flow
# (Settings > Privacy & encryption). See SETUP.md. Leave blank to disable —
# the button will explain it's not configured rather than fail silently.
# iOS's iCloud backup needs no extra config.
GOOGLE_OAUTH_CLIENT_ID=

# LiveKit WebSocket URL for Audio Prayer Room voice (Groups > a room's
# "Join live room"). See SETUP.md. This is just a connection endpoint, safe
# to ship client-side — unlike the LiveKit API key/secret, which must NEVER
# go here. Those live only as Supabase Edge Function secrets (see
# supabase/functions/livekit-token/), since a client-embedded secret could
# be extracted from the app and used to mint tokens for any room. Leave
# blank to disable — rooms fall back to presence-only (no voice).
LIVEKIT_URL=
