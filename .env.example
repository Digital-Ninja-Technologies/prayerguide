SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Android OAuth 2.0 client id for the "back up to Google Drive" flow
# (Settings > Privacy & encryption). See SETUP.md. Leave blank to disable —
# the button will explain it's not configured rather than fail silently.
# iOS's iCloud backup needs no extra config.
GOOGLE_OAUTH_CLIENT_ID=

# RevenueCat public SDK keys for the Upgrade/Premium screen (Settings >
# Upgrade). See SETUP.md for creating a RevenueCat project and linking
# App Store Connect / Google Play Console. Leave all three blank to
# disable — the screen will explain purchases aren't configured yet
# rather than fail silently.
#
# REVENUECAT_API_KEY: a single cross-platform key — used for RevenueCat's
# "Test Store" (keys start with test_) while you don't have real Apple/
# Google developer accounts yet, since Test Store isn't tied to a platform.
# Takes priority over the two platform-specific keys below when set.
REVENUECAT_API_KEY=
# Real per-platform public SDK keys, once you have App Store Connect /
# Google Play Console products linked (appl_... / goog_...).
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
